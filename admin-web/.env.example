# UrTruck production backend, without trailing slash
URTRUCK_BACKEND_URL=https://api.urtruck.kz

# Phase 1: reuse the existing protected backend admin identity.
# Do not commit real values.
URTRUCK_ADMIN_USER=
URTRUCK_ADMIN_PASS=

# 32+ random bytes. Used only by admin-web to sign its HttpOnly session cookie.
ADMIN_SESSION_SECRET=
