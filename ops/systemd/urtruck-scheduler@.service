[Unit]
Description=UrTruck managed scheduler (%i)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/%i/backend
Environment=PYTHONUNBUFFERED=1
Environment=URTRUCK_ENV_FILE=/home/ubuntu/%i/backend/.env
# Нужны явные DB_PATH и URTRUCK_SCHEDULER_LOCK в конфигурации окружения.
# Файл читает Python так же, как API; systemd не преобразует PEM escapes.
ExecStartPre=/home/ubuntu/%i/backend/venv/bin/python -m scheduler.runner --check
ExecStart=/home/ubuntu/%i/backend/venv/bin/python -m scheduler.runner
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
