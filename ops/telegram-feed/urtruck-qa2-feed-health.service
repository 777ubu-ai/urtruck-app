[Unit]
Description=UrTruck QA2 external-feed health (shared collector read-only)
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/urtruck-qa2
ExecStart=/usr/bin/python3 /home/ubuntu/urtruck-qa2/ops/telegram-feed/health.py --qa2-only --source-root /home/ubuntu/urtruck-telegram-feed --qa-root /home/ubuntu/urtruck-qa2 --state-dir /home/ubuntu/urtruck-qa2/external-feed-health/state --alert-config /home/ubuntu/urtruck-telegram-feed/.env
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/urtruck-qa2/external-feed-health/state
PrivateTmp=true
