# Дополнительные настройки существующей единственной Telegram-сессии.
# Реальные значения TELEGRAM_API_ID/HASH/BOT_TOKEN хранить только в secret env.
OWNED_FEED_ENABLED=false
OWNED_TELEGRAM_CTA_ENABLED=false
# Включать CTA только после подтверждения доступа бота к @UrTruck_obyavleniya.
# Бот отвечает на новую заявку кнопками Google Play и App Store; чужие посты не редактирует.
TELEGRAM_BOT_TOKEN=
# Для собственного потока bridge отдельно получает EXTERNAL_FREIGHT_SOURCE_MODE=owned.
# API/adapter state берутся из прежнего EnvironmentFile, без копирования секретов сюда.
