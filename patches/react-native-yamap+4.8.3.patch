+++ b/node_modules/react-native-yamap/android/src/main/java/ru/vvdev/yamap/MapKitViewLifecycle.kt
@@ -0,0 +1,48 @@
+package ru.vvdev.yamap
+
+import com.yandex.mapkit.MapKitFactory
+import com.yandex.mapkit.mapview.MapView
+
+// Keep the SDK and its location listeners active only while a React map is visible.
+internal object MapKitViewLifecycle {
+    private val views = mutableSetOf<MapView>()
+    private var foreground = true
+    private var started = false
+
+    fun add(view: MapView) {
+        if (!views.add(view)) return
+        if (!foreground) return
+        if (!started) {
+            MapKitFactory.getInstance().onStart()
+            started = true
+        }
+        view.onStart()
+    }
+
+    fun remove(view: MapView) {
+        if (!views.remove(view)) return
+        if (foreground && started) view.onStop()
+        if (views.isEmpty() && started) {
+            MapKitFactory.getInstance().onStop()
+            started = false
+        }
+    }
+
+    fun pause() {
+        if (!foreground) return
+        foreground = false
+        if (!started) return
+        views.forEach(MapView::onStop)
+        MapKitFactory.getInstance().onStop()
+        started = false
+    }
+
+    fun resume() {
+        if (foreground) return
+        foreground = true
+        if (views.isEmpty()) return
+        MapKitFactory.getInstance().onStart()
+        started = true
+        views.forEach(MapView::onStart)
+    }
+}
