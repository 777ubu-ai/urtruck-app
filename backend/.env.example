# UrTruck Security Backend — environment variables
# Скопируй в .env и заполни. Перезапусти PM2 после изменений.

# ─────────────────────────────────────────────────────────────
# WhatsApp Meta Cloud API (MVP #1)
# Где взять: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1. Создать WhatsApp Business Account → получить WHATSAPP_ACCOUNT_ID (WABA ID)
# 2. Добавить номер → WHATSAPP_PHONE_ID (phone_number_id)
# 3. Создать шаблон "otp_code" (category: AUTHENTICATION, lang: ru),
#    body: "UrTruck: Ваш код {{1}}. Действует 5 минут."
# 4. System User → permanent WHATSAPP_TOKEN (перм. access token)
# Первые 1000 сообщений/мес — бесплатно.
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCOUNT_ID=
# Опционально — имя шаблона и язык (default: otp_code / ru)
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=ru

# Legacy alias (можно не заполнять, если выше уже указано)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────────────────────
# Storage (MVP #3)
# local   — только разработка/тесты; production его не запускает
# supabase — Supabase Storage (нужны URL + SERVICE_KEY + BUCKET)
# s3      — AWS S3 (нужны boto3 и IAM креденшелы)
# ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase
STORAGE_LOCAL_ROOT=/home/ubuntu/urtruck-security/storage
STORAGE_LOCAL_PUBLIC_BASE=/security/storage

SUPABASE_URL=
# Server-only secret from Supabase Settings → API Keys. Never put it in the
# mobile/web build or any EXPO_PUBLIC_/VITE_/NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=urtruck-docs

S3_BUCKET=
S3_REGION=eu-central-1

# Обязательный отдельный ключ для временных ссылок на документы и вложения.
# Production не стартует, если ключ отсутствует или короче 32 байт.
# Сгенерировать: openssl rand -hex 32
FILE_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────
# SMS — Mobizon (production OTP fallback for KZ).
# Где взять: https://mobizon.kz → Личный кабинет → API → Ключи.
# Stage 22: SMS_PROVIDER=mobizon включает реальную доставку через
# модуль services/sms_mobizon.py с retry / timeout / парсингом
# response.code. Без MOBIZON_API_KEY провайдер не вызовется и
# OTP-роутер автоматически уходит в MOCK (для dev) или фоллбэчит
# на следующий канал (для prod).
#
#   SMS_PROVIDER         mobizon | twilio | mock
#   MOBIZON_API_KEY      ключ из ЛК Mobizon (НЕ коммитить!)
#   MOBIZON_API_URL      override базы (default: https://api.mobizon.kz)
#   MOBIZON_SENDER       alpha-name (если зарегистрирован), пусто = default
#   MOBIZON_TIMEOUT      сек на запрос (default: 10)
# ─────────────────────────────────────────────────────────────
SMS_PROVIDER=mock
MOBIZON_API_KEY=
MOBIZON_API_URL=https://api.mobizon.kz
MOBIZON_SENDER=
MOBIZON_TIMEOUT=10

# Twilio — альтернативный SMS провайдер для не-KZ рынков
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─────────────────────────────────────────────────────────────
# Scoring / Security (уже работают в MOCK)
# ─────────────────────────────────────────────────────────────
TG_API_ID=
TG_API_HASH=

# Admin Dashboard Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_in_production
URTRUCK_ADMIN_USER=admin
URTRUCK_ADMIN_PASS=change_me_in_production
URTRUCK_API_KEY=
URTRUCK_ADMIN_TOKEN=
FILE_SIGNING_KEY=
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────
# Environment / Production hardening
# URTRUCK_ENV=production включает startup-guard (services/env_check.py),
# который проверяет наличие реальных каналов OTP, не-local storage,
# не-плейсхолдер ADMIN_PASSWORD, не-* CORS, и BETA_MODE=false.
# URTRUCK_FAIL_ON_BAD_ENV=1 → процесс не стартует при проблемах
# (рекомендуется для prod). Без этого флага только пишет в лог.
# ─────────────────────────────────────────────────────────────
URTRUCK_ENV=
URTRUCK_FAIL_ON_BAD_ENV=

# ─────────────────────────────────────────────────────────────
# Beta / Test mode
# BETA_MODE=true → универсальный OTP-код для тестеров в обход
# SMS/WhatsApp/Telegram. Тестер вводит любой номер + BETA_OTP_CODE
# → получает авторизацию с verification_level=1, автосоздаётся
# профиль "Тестер + последние 4 цифры", role=driver, score=75.
#
# Stage 22: при URTRUCK_ENV=production BETA_MODE по умолчанию
# false (раньше был true — security hole). env_check.py ругается,
# если в prod явно вернуть true. В dev/preview по умолчанию true.
# ─────────────────────────────────────────────────────────────
BETA_MODE=
BETA_OTP_CODE=0000

# ─────────────────────────────────────────────────────────────
# Email OTP (SMTP) — канал для Китая (WhatsApp/TG заблокированы) + резерв.
# Подходит любой SMTP-провайдер: Resend / Amazon SES / SendGrid / Zoho / Yandex.
# Если host/user/password пустые — email_service в MOCK (код в лог, ничего не шлём).
# Порт 587 (STARTTLS) или 465 (SSL). FROM лучше на своём домене (urtruck.kz)
# с настроенными SPF/DKIM — иначе письма уходят в спам.
# ─────────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@urtruck.kz
EMAIL_FROM_NAME=UrTruck
EMAIL_USE_TLS=true

# ─────────────────────────────────────────────────────────────
# CarGoRuqsat integration — Stream A (ТЗ-CGR-001 v1.1)
# Поток А: информационный слой на базе публичных реестров cgr.qoldau.kz.
# Только GET к публичным URL, без ЭЦП, без WebView, без проксирования авторизации.
# См. docs/cgr/TZ-CGR-001-v1.1.md + docs/cgr/DECISIONS.md
#
# CGR_FEATURE_ENABLED  — kill-switch. При false все cron-задачи
#                        не стартуют, эндпоинты отдают 503.
# CGR_IIN_SALT         — ОБЯЗАТЕЛЬНО при FEATURE_ENABLED=true.
#                        Сгенерировать: openssl rand -hex 32
#                        Без него startup упадёт (раздел 8.5 чеклиста).
#                        Хранится в backend/.env, ротация раз в год.
# CGR_SCOREBOARD_INTERVAL_MIN — частота опроса онлайн-табло (default 5)
# CGR_BOOKING_POLL_INTERVAL_MIN — частота опроса активных броней (default 15)
# CGR_BLOCKLIST_CRON   — cron-выражение для обновления чёрного списка
#                        (default '0 3 * * *' = ежедневно 03:00 UTC)
# CGR_RATE_LIMIT_REQUESTS_PER_MIN — порог исходящих к CGR
#                                   (default 20, уточнить после разведки 1.6)
# CGR_PUSH_THROTTLE_MINUTES — не более 1 push в час на бронь (раздел 5.3 чеклиста)
# ─────────────────────────────────────────────────────────────
CGR_FEATURE_ENABLED=false
CGR_BASE_URL=https://cgr.qoldau.kz
CGR_USER_AGENT="UrTruck/1.0 (+https://urtruck.kz; partner-integration)"
CGR_REQUEST_TIMEOUT_SEC=30
CGR_SCOREBOARD_INTERVAL_MIN=5
CGR_BOOKING_POLL_INTERVAL_MIN=15
CGR_BLOCKLIST_CRON="0 3 * * *"
CGR_IIN_SALT=
CGR_RATE_LIMIT_REQUESTS_PER_MIN=20
CGR_PUSH_THROTTLE_MINUTES=60

# ─────────────────────────────────────────────────────────────
# Sentry (новое для проекта). DSN из https://sentry.io проекта UrTruck.
# Если SENTRY_DSN пуст — Sentry не инициализируется (graceful no-op).
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────
# Push (Web VAPID + native Expo/direct FCM/APNs). Push-recovery track
# forensic audit — все три ниже отсутствовали в этом файле, хотя
# читаются в коде (services/push_sender.py, services/push_gateway.py,
# api/push.py) и остались не задокументированы для ops. Значения ниже —
# ТОЛЬКО имена переменных, без реальных секретов.
#
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT — web push (PWA).
#   Сгенерировать: npx web-push generate-vapid-keys
#
# EXPO_ACCESS_TOKEN — опционально, только если Expo-проект в private mode.
#
# PUSH_PROVIDER_MODE — expo (дефолт, ЖИВОЙ путь сегодня) | native | dual.
#   НЕ менять на native/dual без завершённой клиентской регистрации
#   сырых FCM/APNs токенов (Notifications.getDevicePushTokenAsync(),
#   src/utils/push.js) — см. forensic-аудит push recovery track.
#   native полностью останавливает доставку всем, у кого нет
#   provider=fcm/apns записи; dual безопасно деградирует к expo, пока
#   таких записей нет вообще.
#
# FCM (Android, прямой FCM HTTP v1 — services/push_gateway.py FCMProvider):
#   FCM_PROJECT_ID
#   FCM_SERVICE_ACCOUNT_JSON   — весь service-account JSON одной строкой,
#                                ИЛИ:
#   GOOGLE_APPLICATION_CREDENTIALS — путь к файлу service-account JSON.
#
# APNs (iOS, прямой HTTP/2 — services/push_gateway.py APNsProvider):
#   APNS_KEY_ID
#   APNS_TEAM_ID
#   APNS_AUTH_KEY_P8           — содержимое .p8 ключа (PEM, ES256).
#   APNS_BUNDLE_ID             — com.urtruck.app
#   APNS_USE_SANDBOX           — true только для TestFlight/dev-сборок.
# ─────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@urtruck.kz
EXPO_ACCESS_TOKEN=
PUSH_PROVIDER_MODE=expo
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_P8=
APNS_BUNDLE_ID=com.urtruck.app
APNS_USE_SANDBOX=false
