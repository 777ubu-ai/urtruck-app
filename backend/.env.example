# UrTruck Security Backend — environment variables
# Скопируй в .env и заполни. Перезапусти PM2 после изменений.

# ─────────────────────────────────────────────────────────────
# WhatsApp Meta Cloud API (MVP #1)
# Где взять: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1. Создать WhatsApp Business Account → получить WHATSAPP_ACCOUNT_ID (WABA ID)
# 2. Добавить номер → WHATSAPP_PHONE_ID (phone_number_id)
# 3. Создать шаблон "otp_code" (category: AUTHENTICATION, lang: ru),
#    body: "UrTruck: Ваш код {{1}}. Действует 5 минут."
# 4. System User → permanent WHATSAPP_TOKEN (перм. access token)
# Первые 1000 сообщений/мес — бесплатно.
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCOUNT_ID=
# Опционально — имя шаблона и язык (default: otp_code / ru)
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=ru

# Legacy alias (можно не заполнять, если выше уже указано)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────────────────────
# Storage (MVP #3)
# local   — на диск сервера (default, /home/ubuntu/urtruck-security/storage)
# supabase — Supabase Storage (нужны URL + SERVICE_KEY + BUCKET)
# s3      — AWS S3 (нужны boto3 и IAM креденшелы)
# ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/home/ubuntu/urtruck-security/storage
STORAGE_LOCAL_PUBLIC_BASE=/security/storage

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=urtruck-docs

S3_BUCKET=
S3_REGION=eu-central-1

# ─────────────────────────────────────────────────────────────
# Scoring / Security (уже работают в MOCK)
# ─────────────────────────────────────────────────────────────
TG_API_ID=
TG_API_HASH=

# Admin Dashboard Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_in_production

# ─────────────────────────────────────────────────────────────
# Beta / Test mode
# BETA_MODE=true — универсальный OTP-код для тестеров в обход SMS/WhatsApp/Telegram.
# Тестер вводит любой номер + BETA_OTP_CODE → получает авторизацию с verification_level=1,
# автосоздаётся профиль "Тестер + последние 4 цифры", role=driver, verification_level=2, score=75.
# В PROD обязательно BETA_MODE=false.
# ─────────────────────────────────────────────────────────────
BETA_MODE=true
BETA_OTP_CODE=0000
