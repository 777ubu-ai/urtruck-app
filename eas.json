{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://urtruck.kz"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://urtruck.kz"
      }
    },
    "production": {
      "ios": { "autoIncrement": true, "image": "macos-sequoia-15.6-xcode-26.2" },
      "android": { "autoIncrement": true, "credentialsSource": "local" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://urtruck.kz"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6764504167"
      }
    }
  }
}
