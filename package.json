{
  "name": "urtruck",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web && mkdir -p dist/share dist/legal && cp -R web/share/og-default.png web/share/og-trip-template.svg dist/share/ 2>/dev/null || true && cp web/legal/terms.html dist/legal/terms.html 2>/dev/null && cp web/legal/privacy.html dist/legal/privacy.html 2>/dev/null && cp web/legal/support.html dist/legal/support.html 2>/dev/null && cp web/legal/terms.html dist/terms 2>/dev/null && cp web/legal/privacy.html dist/privacy 2>/dev/null && cp web/legal/support.html dist/support 2>/dev/null && cp web/legal/terms.html dist/terms.html 2>/dev/null && cp web/legal/privacy.html dist/privacy.html 2>/dev/null && cp web/legal/support.html dist/support.html 2>/dev/null || true",
    "serve": "npx serve dist",
    "test:e2e": "playwright test",
    "test:e2e:local": "E2E_BASE_URL=http://127.0.0.1:4173 playwright test",
    "test:e2e:live": "RUN_LIVE_TESTS=1 playwright test tests/e2e/*.live.spec.js --workers=1",
    "qa:serik": "playwright test --config qa/playwright.config.js qa/agents/serik.driver.spec.js",
    "qa:boris": "playwright test --config qa/playwright.config.js qa/agents/boris.shipper.spec.js",
    "qa:auditor": "playwright test --config qa/playwright.config.js qa/agents/auditor.full.spec.js",
    "qa:full": "playwright test --config qa/playwright.config.js",
    "qa:cleanup": "node qa/utils/qaCleanup.js",
    "qa:auth-check": "node qa/utils/qaAuthCheck.js",
    "qa:trip-details": "playwright test --config qa/playwright.config.js qa/agents/trip.detail.clicks.spec.js",
    "qa:i18n": "node qa/utils/i18nSmoke.js",
    "qa:zh": "node qa/utils/zhLocalizationSmoke.js",
    "qa:currency": "node qa/utils/currencySmoke.js",
    "qa:theme": "node qa/utils/themeSmoke.js",
    "qa:geo": "node qa/utils/geographySmoke.js",
    "qa:bargain": "playwright test --config qa/playwright.config.js qa/agents/bargain.flow.spec.js",
    "qa:ux": "node qa/utils/uxSmoke.js",
    "qa:trip-status": "node qa/utils/tripStatusSmoke.js",
    "qa:gps-consent": "node qa/utils/gpsConsentSmoke.js",
    "qa:share-locale": "node qa/utils/shareLocaleSmoke.js",
    "qa:buttons": "node qa/utils/buttonDesignSmoke.js",
    "qa:maestro-contract": "node qa/utils/maestroContractSmoke.js",
    "qa:mobile": "playwright test --config qa/playwright.mobile.config.js",
    "qa:center:quick": "npm run qa:release-version && npm run qa:i18n && npm run qa:zh && npm run qa:currency && npm run qa:theme && npm run qa:theme-contrast && npm run qa:theme-unit && npm run qa:geo && npm run qa:nav && npm run qa:prodocs && npm run qa:favorites && npm run qa:keystore && npm run qa:ux && npm run qa:trip-status && npm run qa:gps-consent && npm run qa:share-locale && npm run qa:buttons && npm run qa:maestro-contract && npm run build:web",
    "qa:center:web": "npm run build:web && playwright test --config qa/playwright.mobile.config.js",
    "qa:center:maestro:smoke": "maestro test qa/maestro/smoke-suite.yaml --format junit --output qa/artifacts/maestro-smoke.xml",
    "postinstall": "patch-package",
    "qa:release-version": "node qa/utils/releaseVersionSmoke.js",
    "qa:theme-contrast": "node qa/utils/themeContrastSmoke.js",
    "qa:theme-unit": "node tests/unit/themeResolve.test.mjs",
    "qa:nav": "node qa/utils/navContractSmoke.js",
    "qa:prodocs": "node qa/utils/proDocsContractSmoke.js",
    "qa:keystore": "node qa/utils/noTrackedKeystoreSmoke.js",
    "qa:favorites": "node qa/utils/favoritesContractSmoke.js",
    "qa:locale-runtime": "node qa/utils/runtimeLocaleLeakProbe.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@sentry/react-native": "~6.10.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/react": "~18.3.12",
    "expo": "~52.0.46",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.11",
    "expo-font": "~13.0.4",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-keep-awake": "~14.0.2",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.13",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-task-manager": "~12.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-maps": "1.18.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "^1.59.1",
    "patch-package": "^8.0.1"
  }
}
