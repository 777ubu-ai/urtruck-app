{
  "expo": {
    "name": "UrTruck",
    "slug": "urtruck",
    "version": "1.0.9",
    "orientation": "portrait",
    "scheme": "urtruck",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urtruck.app",
      "buildNumber": "73",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:urtruck.kz"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "UrTruck использует микрофон для записи голосовых сообщений в чате",
        "NSCameraUsageDescription": "UrTruck использует камеру для селфи и фото документов",
        "NSPhotoLibraryUsageDescription": "UrTruck использует фото для аватара, груза и документов",
        "NSLocationWhenInUseUsageDescription": "UrTruck определяет местоположение по вашему запросу или при открытии карты активного рейса",
        "NSMotionUsageDescription": "Встроенная библиотека местоположения поддерживает определение движения. UrTruck не запрашивает и не собирает данные физической активности в этой версии.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.urtruck.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "urtruck.kz",
              "pathPrefix": "/notifications"
            },
            {
              "scheme": "https",
              "host": "urtruck.kz",
              "pathPrefix": "/cargos"
            },
            {
              "scheme": "https",
              "host": "urtruck.kz",
              "pathPrefix": "/trips"
            },
            {
              "scheme": "https",
              "host": "urtruck.kz",
              "pathPrefix": "/driver"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1a"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "./plugins/withAndroidBackCompatibility",
      "./plugins/withAndroidSingleFcmHandler",
      [
        "expo-audio",
        {
          "microphonePermission": "UrTruck использует микрофон для записи голосовых сообщений"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UrTruck использует фото для аватара, груза и документов",
          "cameraPermission": "UrTruck использует камеру для селфи и фото документов"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#22C55E",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UrTruck определяет местоположение по вашему запросу или при открытии карты активного рейса",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "898bd902-ea62-49f6-96c3-b6e02219f828"
      }
    }
  }
}
