{
  "expo": {
    "name": "UrTruck",
    "slug": "urtruck",
    "version": "1.0.7",
    "orientation": "portrait",
    "scheme": "urtruck",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash/urtruck-splash.png",
      "backgroundColor": "#070B14",
      "resizeMode": "contain"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.urtruck.app",
      "buildNumber": "27",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:urtruck.kz"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "UrTruck использует микрофон для записи голосовых сообщений в чате",
        "NSCameraUsageDescription": "UrTruck использует камеру для селфи и фото документов",
        "NSPhotoLibraryUsageDescription": "UrTruck использует фото для аватара, груза и документов",
        "NSLocationWhenInUseUsageDescription": "UrTruck показывает грузоотправителю, где сейчас находится его груз во время перевозки",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "UrTruck передаёт позицию машины грузоотправителю во время активного рейса, чтобы он видел, где груз. Работает только пока есть сделка в пути."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.urtruck.app",
      "userInterfaceStyle": "automatic",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "urtruck.kz",
              "pathPrefix": "/notifications"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1a"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withAndroidBackCompat",
      "expo-system-ui",
      "./plugins/withAndroidSplashSize",
      [
        "expo-av",
        {
          "microphonePermission": "UrTruck использует микрофон для записи голосовых сообщений"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UrTruck использует фото для аватара, груза и документов",
          "cameraPermission": "UrTruck использует камеру для селфи и фото документов"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#22C55E",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UrTruck показывает грузоотправителю, где сейчас находится его груз во время перевозки",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "898bd902-ea62-49f6-96c3-b6e02219f828"
      }
    }
  }
}
