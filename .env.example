# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_BOT_USERNAME=UrTruckbot
# При setWebhook?secret_token=X — тот же X сюда (Telegram шлёт в X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SECRET_KEY=generate-random-string-here

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-id

# SMS (Mobizon)
MOBIZON_API_KEY=your-mobizon-key

# Deploy
SSH_HOST=your-server-ip
SSH_USER=your-user

# CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://185.22.65.11:8080

# VAPID (Push notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@urtruck.kz

# eGov
EGOV_P12_PATH=
EGOV_P12_PASSWORD=

# Maps
# Web build uses HERE JS SDK when EXPO_PUBLIC_HERE_API_KEY is set.
# Keep real keys in local/EAS/Vercel secrets, never commit them.
EXPO_PUBLIC_HERE_API_KEY=
